{
    "model": "ANN",
    "classification_type": "binary",
    "n_job": 1,
    "params": {
        "draw_model": true,
        "random_state": 500,
        "cv_splits": 5,
        "batch_size": 128,
        "train_grid": "train_random"
    },
    "params_grid": {
        "objective": [
            "accuracy"
        ],
        "max_layers": 3,
        "min_units": 4,
        "max_units": 512,
        "step_units": 4,
        "output_units": 2,
        "activation": [
            "relu",
            "elu",
            "tanh",
            "sigmoid",
            "softmax",
            "linear",
            "exponential"
        ],
        "dropout": true,
        "dropout_rate": 0.15,
        "optimizer": [
            "Adam",
            "RMSprop",
            "SGD",
            "Adagrad"
        ],
        "min_lr": 0.0001,
        "max_lr": 0.01,
        "sampling_lr": "log",
        "metrics": [
            "accuracy"
        ],
        "loss_function": "sparse_categorical_crossentropy",
        "epochs": 80,
        "executions_per_trial": 5,
        "early_stopping_patience": 5
    },
    "feature_reduction": {
        "fill_nan": "mean",
        "remove_empty_cols": 0.95,
        "drop_min_variance": 0.0,
        "outliers": "turkey",
        "selection": "backward",
        "p_value_threshold": 0.05,
        "max_features": null,
        "min_features": 1
    },
    "interpretability": {
        "Lime": {
            "num_samples": 5000,
            "discretize_continuous": true,
            "discretizer": "entropy",
            "feature_selection": "forward_selection",
            "top_labels": 1
        },
        "Shapley": {},
        "IntegratedGradients": {
            "method": "riemann_trapezoid",
            "n_steps": 50,
            "baseline": "mean",
            "surrogate": {
                "hidden_units": [
                    64,
                    32
                ],
                "epochs": 100,
                "batch_size": 32,
                "learning_rate": 0.001,
                "verbose": 0
            }
        },
        "PermutationImportance": {
            "n_repeats": 5,
            "n_jobs": 1
        },
        "MDI": {
            "n_estimators": 100,
            "random_state": null
        },
        "Counterfactuals": {
            "method": "random",
            "total_CFs": 10,
            "posthoc_sparsity_algorithm": "binary"
        },
        "Anchor": {
            "threshold": 0.95,
            "disc_perc": [
                25,
                50,
                75
            ]
        },
        "PDP": {},
        "ALE": {}
    }
}

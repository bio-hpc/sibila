{
    "model": "VOT",
    "base_models": [
        "BAG",
        "DT",
        "KNN",
        "LR",
        "RF",
        "RP",
        "SVM",
        "XGB"
    ],
    "remove_outliers": false,
    "params": {
        "rfmode": "classify",
        "n_jobs": "8"
    },
    "params_grid": {},
    "classification_type": "binary",
    "metric_weights": {
        "Precision": 0.2,
        "F1": 0.2,
        "Recall": 0.1,
        "Specificity": 0.1,
        "MCC": 0.1,
        "Coefficient of Determination": 0.5,
        "Mean Absolute Error": -0.1,
        "Mean Squared Error": -0.1,
        "Root Mean Squared Error": -0.1
    },
    "feature_reduction": {
        "fill_nan": "mean",
        "remove_empty_cols": 0.95,
        "drop_min_variance": 0.0,
        "outliers": "turkey",
        "selection": "backward",
        "max_features": 5
    }
}

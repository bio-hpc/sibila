{
    "model": "VOT",
    "base_models": [
        "BAG",
        "DT",
        "KNN",
        "LR",
        "RF",
        "RP",
        "SVM",
        "XGB"
    ],
    "remove_outliers": false,
    "params": {
        "rfmode": "classify",
        "n_jobs": "8"
    },
    "params_grid": {},
    "classification_type": "binary",
    "metric_weights": {
        "Precision": 0.2,
        "F1": 0.2,
        "Recall": 0.1,
        "Specificity": 0.1,
        "MCC": 0.1,
        "Coefficient of Determination": 0.5,
        "Mean Absolute Error": -0.1,
        "Mean Squared Error": -0.1,
        "Root Mean Squared Error": -0.1
    },
    "feature_reduction": {
        "fill_nan": "mean",
        "remove_empty_cols": 0.95,
        "drop_min_variance": 0.0,
        "outliers": "turkey",
        "selection": "backward",
        "p_value_threshold": 0.05,
        "max_features": null,
        "min_features": 1
    },
    "interpretability": {
        "Lime": {
            "num_samples": 5000,
            "discretize_continuous": true,
            "discretizer": "entropy",
            "feature_selection": "forward_selection",
            "top_labels": 1
        },
        "Shapley": {},
        "IntegratedGradients": {
            "method": "riemann_trapezoid",
            "n_steps": 50,
            "baseline": "mean",
            "surrogate": {
                "hidden_units": [
                    64,
                    32
                ],
                "epochs": 100,
                "batch_size": 32,
                "learning_rate": 0.001,
                "verbose": 0
            }
        },
        "PermutationImportance": {
            "n_repeats": 5,
            "n_jobs": 1
        },
        "MDI": {
            "n_estimators": 100,
            "random_state": null
        },
        "Counterfactuals": {
            "method": "random",
            "total_CFs": 10,
            "posthoc_sparsity_algorithm": "binary"
        },
        "Anchor": {
            "threshold": 0.95,
            "disc_perc": [
                25,
                50,
                75
            ]
        },
        "PDP": {},
        "ALE": {}
    }
}
